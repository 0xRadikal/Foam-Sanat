# =============================================================================
# Foam-Sanat — Environment variable template
# =============================================================================
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# All values below are SAFE PLACEHOLDERS / documented public test values only.
# Do NOT paste production secrets into this file — it is committed to git.
#
# Variable groups:
#   NEXT_PUBLIC_*  -> exposed to the browser bundle (must contain NO secrets)
#   everything else -> server-only (never sent to the client)
# =============================================================================

# -----------------------------------------------------------------------------
# Public site configuration (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_PHONE_FA=+980000000000
NEXT_PUBLIC_CONTACT_PHONE_EN=+980000000000
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com
# Analytics IDs are public identifiers, not secrets. Leave blank to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
# Cloudflare Turnstile SITE key is public by design.
# Official always-passes TEST site key (safe to commit):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Preview deployment origin (used for CORS allow-listing in preview envs).
NEXT_PUBLIC_PREVIEW_URL=https://preview.example.com

# -----------------------------------------------------------------------------
# Server-only contact configuration
# -----------------------------------------------------------------------------
CONTACT_PHONE_FA=+980000000000
CONTACT_PHONE_EN=+980000000000
CONTACT_EMAIL=info@example.com

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (server-side verification) — SECRET
# -----------------------------------------------------------------------------
# Official always-passes TEST secret key (safe to commit; replace in production):
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# Comments admin auth — SECRETS (generate strong random values in production)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
COMMENTS_ADMIN_TOKEN_SECRET=replace-with-strong-random-secret
# Rotatable list (comma-separated) — first entry is used for signing:
COMMENTS_ADMIN_TOKEN_SECRETS=replace-with-strong-random-secret
COMMENTS_ADMIN_TOKEN_TTL_MINUTES=120
# Allowed admin identities (comma-separated emails/ids that may mint a session):
COMMENTS_ADMIN_IDENTITIES=admin@example.com
COMMENTS_ADMIN_ID=admin
COMMENTS_ADMIN_NAME=Site Admin

# -----------------------------------------------------------------------------
# Transactional email (Resend) — SECRET
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_replace_with_real_key
RESEND_FROM_EMAIL=no-reply@example.com

# -----------------------------------------------------------------------------
# Storage backend
# -----------------------------------------------------------------------------
# One of: sqlite | postgres | memory
COMMENTS_STORAGE_BACKEND=sqlite
# For sqlite: a file path URL. For postgres: a full connection string.
#   sqlite   -> file:./data/comments.db
#   postgres -> postgres://user:password@host:5432/dbname
COMMENTS_DATABASE_URL=file:./data/comments.db
DATABASE_URL=file:./data/comments.db

# -----------------------------------------------------------------------------
# Rate limiting / Redis (optional — falls back to in-memory if unset)
# -----------------------------------------------------------------------------
# NOTE: Redis default port is 6379, not 3000.
RATE_LIMIT_REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# CORS / origin allow-listing
# -----------------------------------------------------------------------------
COMMENTS_ALLOWED_ORIGINS=https://example.com
ALLOWED_ORIGINS=https://example.com
COMMENTS_ALLOWED_PREVIEW_URLS=https://preview.example.com
ALLOWED_PREVIEW_ORIGINS=https://preview.example.com
PREVIEW_URL=https://preview.example.com
