{
  "name": "foam-sanat",
  "private": true,
  "version": "1.0.0",
  "description": "Foam Sanat | PU Foam Injection Machinery - Next.js production setup",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "analyze": "ANALYZE=true next build",
    "sitemap": "next-sitemap",
    "axe": "node ./scripts/run-axe.mjs http://localhost:3000",
    "lighthouse": "node ./scripts/run-lighthouse.mjs http://localhost:3000",
    "postbuild": "npm run sitemap",
    "preview:audits": "node ./scripts/run-preview-audits.mjs",
    "preview:e2e": "playwright test --config=playwright.config.ts --reporter=line",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@fontsource/vazirmatn": "^5.2.8",
    "@prisma/client": "^5.19.1",
    "@tanstack/react-virtual": "^3.13.12",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.6",
    "docker": "^1.0.0",
    "isomorphic-dompurify": "^2.33.0",
    "lucide-react": "^0.552.0",
    "next": "^14.2.33",
    "next-auth": "^4.24.13",
    "pg": "^8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "^4.7.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/cli": "4.10.0",
    "@axe-core/playwright": "^4.11.0",
    "@next/bundle-analyzer": "^14.2.33",
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.9",
    "@types/redis": "^4.0.10",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.21",
    "chromedriver": "^142.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.13",
    "lighthouse": "^12.0.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.6",
    "prisma": "^5.19.1",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
